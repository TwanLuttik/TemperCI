[Unit]
Description=TemperCI guest runner agent (JIT one-shot)
# Do NOT wait for network-online: this image uses kernel cmdline IP and may not
# run networkd, so network-online can hang forever and the agent never starts.
After=local-fs.target
DefaultDependencies=yes

[Service]
Type=simple
Restart=no
Environment=NODE_EXTRA_CA_CERTS=/usr/local/share/ca-certificates/temperci-cache.crt
Environment=SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
Environment=REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
ExecStart=/usr/local/sbin/temperci-runner-agent.sh
StandardOutput=journal+console
StandardError=journal+console
# Long GitHub jobs (simple service runs until runner exits)
TimeoutStartSec=infinity
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
